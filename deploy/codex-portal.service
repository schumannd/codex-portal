[Unit]
Description=Schumann Codex Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexportal
Group=codexportal
WorkingDirectory=/opt/codex-portal
EnvironmentFile=/etc/codex-portal.env
Environment=HOME=/var/lib/codex-portal
Environment=DATA_DIR=/var/lib/codex-portal/data
ExecStart=/usr/bin/node /opt/codex-portal/src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-portal
# Codex requires unprivileged user namespaces for its workspace sandbox.
RestrictSUIDSGID=true
KillMode=control-group
TimeoutStopSec=15
MemoryMax=3G
TasksMax=256

[Install]
WantedBy=multi-user.target
